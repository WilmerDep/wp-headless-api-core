    {
      "slug": "hosgedopol-citas-en-linea",
      "title": "HOSGEDOPOL · Citas en Línea",
      "status": "publish",
      "mode": "visual",
      "subject": "Nueva solicitud de cita — {{field.firstName}} {{field.lastName}}",
      "preheader": "Nueva solicitud recibida desde Citas en Línea.",
      "visual": {
        "logoUrl": "",
        "outerBackground": "#f5f8fb",
        "headerBackground": "#06477f",
        "labelColor": "#123f68",
        "valueColor": "#344f67",
        "separatorColor": "#e8eef3",
        "eyebrow": "HOSGEDOPOL · Citas en Línea",
        "heading": "Nueva solicitud de cita",
        "intro": "",
        "footer": ""
      },
      "textFallback": "Nueva solicitud de cita\n\n{{form.fields}}"
